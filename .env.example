ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=
ZAI_CONTEXT_WINDOW_TOKENS=
MOCK_AGENT=false
# Absolute path to your own Python interpreter; blank uses python3 on PATH.
PYTHON_BIN=
BLOCKFROST_API_KEY_PREPROD=
EVE_PORT=21949
EVE_URL=http://127.0.0.1:21949
COWORKER_ID=
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
AGENT_AUTHOR=

MPS_PORT=38127
MPS_URL=http://127.0.0.1:38127

AGENT_API_PORT=21950
PAID_TASKS_ENABLED=false

# Negotiator LLM adapter (llm-adapter branch, off by default). The provider defaults to openai_compatible (ZAI_* above).
NEGOTIATOR_LLM=off
NEGOTIATOR_LLM_PROVIDER=
NEGOTIATOR_LLM_FAKE_REPLIES=
# NEGOTIATOR_LLM_PROVIDER=deepseek reads these; base URL and model default to https://api.deepseek.com and deepseek-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_MAX_TOKENS=
NEGOTIATOR_LLM_TIMEOUT_S=
NEGOTIATOR_LLM_BUDGET_S=
# With NEGOTIATOR_LLM=on, the model also picks among code-priced buyer offers (off while PAID_TASKS_ENABLED=true).
NEGOTIATOR_TACTICIAN=off
